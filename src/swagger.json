{
  "openapi": "3.0.1",
  "info": {
    "title": "Servico de Integracao Tuya",
    "description": "Servico interno para controle de dispositivos Tuya (mock ou integracao real).",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "Health",
      "description": "Verificacao de disponibilidade da API."
    },
    {
      "name": "Dispositivos",
      "description": "Operacoes de ligacao, desligamento, status e consumo de dispositivos."
    }
  ],
  "paths": {
    "/v1/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Retorna o status de funcionamento da API e o ambiente atual.",
        "responses": {
          "200": {
            "description": "API em funcionamento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseHealth"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/healthcheck": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check (alias)",
        "description": "Alias de health check para compatibilidade.",
        "responses": {
          "200": {
            "description": "API em funcionamento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseHealth"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/devices/{deviceId}/turn-on": {
      "post": {
        "tags": [
          "Dispositivos"
        ],
        "summary": "Ligar dispositivo",
        "description": "Aciona energizacao de um dispositivo Tuya.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador do dispositivo Tuya."
          }
        ],
        "responses": {
          "200": {
            "description": "Comando executado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCommand"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          },
          "400": {
            "description": "Erro ao processar requisicao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          },
          "500": {
            "description": "Erro ao processar requisicao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/devices/{deviceId}/turn-off": {
      "post": {
        "tags": [
          "Dispositivos"
        ],
        "summary": "Desligar dispositivo",
        "description": "Desliga um dispositivo Tuya.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador do dispositivo Tuya."
          }
        ],
        "responses": {
          "200": {
            "description": "Comando executado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCommand"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          },
          "400": {
            "description": "Erro ao processar requisicao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          },
          "500": {
            "description": "Erro ao processar requisicao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/devices/{deviceId}/status": {
      "get": {
        "tags": [
          "Dispositivos"
        ],
        "summary": "Consultar status do dispositivo",
        "description": "Retorna se o dispositivo esta ligado ou desligado.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador do dispositivo Tuya."
          }
        ],
        "responses": {
          "200": {
            "description": "Status retornado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDeviceStatus"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          },
          "400": {
            "description": "Erro ao processar requisicao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          },
          "500": {
            "description": "Erro ao processar requisicao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/devices/{deviceId}/consumption": {
      "get": {
        "tags": [
          "Dispositivos"
        ],
        "summary": "Consultar consumo do dispositivo",
        "description": "Retorna potencia instantanea e energia acumulada do dispositivo.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identificador do dispositivo Tuya."
          }
        ],
        "responses": {
          "200": {
            "description": "Consumo retornado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDeviceConsumption"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          },
          "400": {
            "description": "Erro ao processar requisicao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          },
          "500": {
            "description": "Erro ao processar requisicao.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "HealthData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "API Funcionando!"
          },
          "environment": {
            "type": "string",
            "example": "development"
          }
        }
      },
      "ApiResponseHealth": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/HealthData"
          },
          "message": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "errors": {
            "type": "string",
            "nullable": true,
            "example": null
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "data": {
            "nullable": true,
            "example": null
          },
          "message": {
            "type": "string",
            "example": "Erro ao processar requisicao."
          },
          "errors": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          }
        }
      },
      "DeviceCommand": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "enum": [
              "TURN_ON",
              "TURN_OFF"
            ]
          },
          "mocked": {
            "type": "boolean"
          }
        }
      },
      "DeviceStatus": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "isOn": {
            "type": "boolean"
          }
        }
      },
      "DeviceConsumption": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "powerWatts": {
            "type": "number"
          },
          "energyKwh": {
            "type": "number"
          },
          "sampledAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApiResponseCommand": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseHealth"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/DeviceCommand"
              }
            }
          }
        ]
      },
      "ApiResponseDeviceStatus": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseHealth"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/DeviceStatus"
              }
            }
          }
        ]
      },
      "ApiResponseDeviceConsumption": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseHealth"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/DeviceConsumption"
              }
            }
          }
        ]
      }
    },
    "headers": {
      "RequestIdHeader": {
        "description": "Identificador unico da requisicao para rastreabilidade.",
        "schema": {
          "type": "string",
          "example": "f25f63b8-2b89-4fc0-8a2e-7b2e8c7d6f53"
        }
      },
      "ActorHeader": {
        "description": "Ator identificado para a requisicao.",
        "schema": {
          "type": "string",
          "example": "SWAGGER"
        }
      }
    }
  }
}
